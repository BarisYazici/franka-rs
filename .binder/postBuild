#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"
export CARGO_BUILD_JOBS=1
export RUSTUP_TOOLCHAIN=1.98.0
if ! command -v rustup >/dev/null; then
    curl --fail --show-error --silent --location https://sh.rustup.rs -o /tmp/franka-notebook-rustup.sh
    sh /tmp/franka-notebook-rustup.sh -y --profile minimal --default-toolchain "$RUSTUP_TOOLCHAIN"
elif ! rustup run "$RUSTUP_TOOLCHAIN" rustc --version >/dev/null 2>&1; then
    rustup toolchain install "$RUSTUP_TOOLCHAIN" --profile minimal --no-self-update
fi
# Build the native bindings from this exact Binder checkout, once per image.
maturin build --release --locked -m crates/franka-py/Cargo.toml --out .binder/wheels
python -m pip install --disable-pip-version-check .binder/wheels/franka_rs-*.whl
python -m venv .binder/sim-venv
.binder/sim-venv/bin/python -m pip install --disable-pip-version-check -r .binder/simulator-requirements.txt
python .binder/fetch_model.py
python .binder/smoke.py
