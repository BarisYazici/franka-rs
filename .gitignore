/target
# Local read-only clones of the C++/Rust references (libfranka, libfranka-rs) and their logs.
/reference
/tools/model-reference/build
/worktrees
/bench/cpp/build
/bench/rust/target
/bench/model-micro/cpp/build
/bench/model-micro/rust/target
/bench/so-micro/cpp/build
/bench/so-micro/rust/target
# Regenerable and large (~13 MB per run): the shared input set and the C++ reference outputs.
/bench/model-micro/results/*/states.json
/bench/model-micro/results/*/reference.bin
/bench/results/run-full.log
# Wire captures of the FCI traffic: 30-220 MB each, regenerable with
# bench/fer-capture/capture.sh.
*.pcap
*.pcapng
# Build/run logs.
**/*.log
# The advisory lock bench/run.sh and the simulator tests take at the repository root.
.sim.lock
__pycache__/
# The owner's private notes. `.private` is a symlink here, and a trailing slash would match
# only a real directory, so the pattern carries none.
/.private
/CLAUDE.md
# Agent scratch trees.
/.superpowers/
/docs/superpowers/
# Local recordings and demo material.
/videos/
# Local experimental measurements; preserved, not release inputs.
/crates/franka-node/tests/sim_sweep.rs
/crates/franka-node/tests/sweep/

# Only the three curated website clips are versioned; local source recordings stay private.
/docs/site/media/*.mp4
!/docs/site/media/architecture-overview.mp4
!/docs/site/media/bridge-demo.mp4
!/docs/site/media/rerun-demo.mp4
